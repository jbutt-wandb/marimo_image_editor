# Copy to .env (gitignored) and fill in YOUR values — none of these are shared.

# REQUIRED — how the launcher creates/drives sandboxes. Create a console token
# with the "Sandbox User" IAM role at console.coreweave.com/tokens.
CWSANDBOX_API_KEY=<your-coreweave-console-token>

# OPTIONAL — Weave/Forge tracing. Without these the app runs identically but
# untraced. Changing WEAVE_PROJECT and relaunching switches tracing projects.
WANDB_API_KEY=<your-forge-wandb-api-key>
WEAVE_PROJECT=<your-entity/your-project>

# OPTIONAL — joining an existing team setup: adopt a teammate's snapshot and
# skip the ~30-60 min seed. Only consulted when .launch/sandbox-state.json has
# no snapshot of its own (i.e. fresh clones); your local state always wins.
# SNAPSHOT_ID=<team-snapshot-id>

# OPTIONAL — custom container image (see repo-root Dockerfile). Overrides the
# stock pytorch image for every sandbox; pin by digest, not tag. Until set,
# the launcher's runtime guards install the missing tools instead.
# SANDBOX_IMAGE=<registry>/image-studio-base@sha256:<digest>
